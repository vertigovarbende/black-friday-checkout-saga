# Lombok ayarları (05-domain-kararlari §5). Bütün modüller bu dosyayı kullanır.
config.stopBubbling = true

# Kapalı: açık olursa Lombok ürettiği koda @lombok.Generated koyar. Bu annotation derlenmiş sınıfta
# kaldığı için ArchUnit kural 1 domain'in Lombok'a bağımlı olduğunu söyler. Bedeli: JaCoCo Lombok'un
# ürettiği kodu da sayar (raporda eşik yok).
lombok.addLombokGeneratedAnnotation = false
