<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.deveyk.orderflow</groupId>
        <artifactId>orderflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>shared-test-support</artifactId>
    <description>Test taban sınıfları, TestDataBuilder, container'lar, mesajlaşma araçları, golden JSON sözleşmeleri. Servisler test scope'uyla ekler.</description>

    <dependencies>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-domain</artifactId>
        </dependency>
        <!-- web/*: GlobalExceptionHandler (SharedWebAutoConfiguration) ve OrderflowHeaders -->
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-observability</artifactId>
        </dependency>
        <!-- Kod src/main'de olduğu için compile scope; servisler bu modülü zaten test scope'uyla ekler.
             JUnit, Mockito, AssertJ ve Logback (spring-boot-starter-logging üzerinden) buradan gelir. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
        </dependency>
        <!-- container/OrderflowContainers.kafka(), messaging/MessageProbe -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        <!-- MessageProbe ve connector kaydında asenkron bekleme (07 §8.3) -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
        </dependency>
        <!-- container/DebeziumConnectors: connector JSON'unu okuyup Connect'e gönderir -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- messaging/OutboxAssert: outbox tablosunu JdbcTemplate ile okur -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-architecture</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
