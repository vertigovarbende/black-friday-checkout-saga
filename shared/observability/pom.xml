<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.deveyk.orderflow</groupId>
        <artifactId>orderflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>shared-observability</artifactId>
    <description>Gözlem altyapısı (Spring Boot starter): TraceContextProvider, CorrelationIdFilter, UseCaseObservationAspect, MdcKeys, OrderflowHeaders, ErrorFamily (08-loglama-kararlari).</description>

    <dependencies>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
        </dependency>
        <!-- UseCaseObservationAspect: Spring AOP + AspectJ annotation'ları (Boot 4'te spring-boot-starter-aop'un yeni adı) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- CorrelationIdFilter: OncePerRequestFilter ve MDC -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- UseCaseObservationAspectTest: UseCaseHandler'ı uygulayan bir test handler'ı -->
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-application</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-architecture</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
