<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.deveyk.orderflow</groupId>
        <artifactId>orderflow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>product-service</artifactId>
    <description>Ürünler, stok ve stok rezervasyonları.</description>

    <dependencies>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-outbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-inbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Topic'ler (KafkaAdmin + NewTopic), listener'lar ve DLT. Event'leri Kafka'ya Debezium taşır (ADR-0005). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- Gözlem (08 §15): health + /actuator/prometheus, Micrometer Tracing + OpenTelemetry + OTLP export -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-datasource-routing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Sadece derleme zamanı; jar'a girmez -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @AutoConfigureTracing: testlerde tracing varsayılan olarak kapalı; IT'lerde açık, export kapalı (07 §5) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.deveyk.orderflow</groupId>
            <artifactId>shared-architecture</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
